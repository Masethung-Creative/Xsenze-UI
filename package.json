{
  "name": "xsenze-ui",
  "version": "0.9.0",
  "description": "Xsenze UI Kit: design tokens, CSS components and small behaviours for HTML, PHP and framework projects.",
  "license": "MIT",
  "homepage": "https://xsenze-ui.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Masethung-Creative/Xsenze-UI.git"
  },
  "type": "module",
  "main": "dist/xsenze.js",
  "style": "dist/xsenze.css",
  "files": [
    "dist",
    "!dist/fonts/Satoshi-Variable.woff2",
    "!dist/fonts/Satoshi-FFL.txt",
    "tokens",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/xsenze.esm.js",
    "./css": "./dist/xsenze.css",
    "./satoshi.css": "./dist/xsenze-satoshi.css",
    "./tokens.css": "./dist/tokens/tokens.css",
    "./tokens.json": "./dist/tokens/tokens.json",
    "./charts": "./dist/xsenze-charts.esm.js",
    "./apps": "./dist/xsenze-apps.esm.js",
    "./tools": "./dist/xsenze-tools.esm.js",
    "./tools.css": "./dist/xsenze-tools.css",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/contrast.mjs",
    "dev": "node scripts/serve.mjs",
    "docs": "node scripts/docs/build.mjs",
    "check:docs": "node scripts/docs/check.mjs",
    "site": "node scripts/site.mjs",
    "prepublishOnly": "node scripts/build.mjs --strict && npm run check"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.73.0"
  }
}
